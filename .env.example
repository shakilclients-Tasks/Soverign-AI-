SOVEREIGN_APP_NAME="Sovereign AI"
SOVEREIGN_APP_ENV="development"
SOVEREIGN_DEBUG=false
SOVEREIGN_BACKEND_HOST="127.0.0.1"
SOVEREIGN_BACKEND_PORT=8000
SOVEREIGN_OLLAMA_BASE_URL="http://127.0.0.1:11434"
SOVEREIGN_OLLAMA_KEEP_ALIVE="60m"
SOVEREIGN_OLLAMA_CONTEXT_WINDOW=2048
SOVEREIGN_OLLAMA_NUM_PREDICT=384
SOVEREIGN_OLLAMA_NUM_BATCH=512
# Optional. When omitted, the first detected compatible chat model is selected.
# SOVEREIGN_CHAT_MODEL=""
SOVEREIGN_EMBEDDING_MODEL="nomic-embed-text:latest"
SOVEREIGN_DATA_DIR="data"
SOVEREIGN_UPLOADS_DIR="data/uploads"
SOVEREIGN_CHROMA_DIR="data/chroma"
SOVEREIGN_SQLITE_DB_PATH="data/database/sovereign.db"
SOVEREIGN_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
SOVEREIGN_MAX_UPLOAD_MB=25
SOVEREIGN_SANDBOX_IMAGE="python:3.11-alpine"
SOVEREIGN_AIR_GAPPED_MODE=true
